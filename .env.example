# Contact form (app/api/contact) — https://resend.com
# Resend → API keys → Create API key ("Sending access").
RESEND_API_KEY=
# Inbox that receives messages. Optional; defaults to the email in lib/data.ts.
# Until you verify a domain in Resend, this must be the email you signed up to Resend with.
CONTACT_TO_EMAIL=
# Optional, after verifying your domain in Resend → Domains, e.g. Parth Lodat <hello@parthlodat.in>
# Setting it also sends visitors an automatic "thanks, I got your message" reply.
CONTACT_FROM_EMAIL=
